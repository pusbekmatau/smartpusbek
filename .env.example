# ---------------------------------------------------------------------------
# SMART PUSBEKMATAU — environment configuration
# Copy to .env.local (development) or set in your hosting provider.
# ---------------------------------------------------------------------------

# REQUIRED in production: random secret (min. 32 chars) used to sign sessions.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Two-way live sync (Primary mode). Leave empty to run in local-sync fallback mode.
# Service account e-mail and private key from the Google Cloud console (JSON key).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the key on one line with literal \n sequences, wrapped in double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Server-side cache lifetime for module data (seconds). Default 300.
DATA_CACHE_TTL_SECONDS=300

# Directory for users, audit log and the local write overlay. Default ./data
# Must be a persistent, writable volume in production.
DATA_DIR=

# Optional: override the seed passwords used on FIRST boot only.
SEED_ADMIN_PASSWORD=
SEED_OPERATOR_PASSWORD=
SEED_VIEWER_PASSWORD=

# Set to "false" ONLY when serving production over plain HTTP on a trusted LAN.
COOKIE_SECURE=
