# ---------------------------------------------------------------------------
# SMART PUSBEKMATAU — konfigurasi build (situs statis GitHub Pages)
# Untuk pengembangan lokal: salin ke .env.local lalu jalankan `npm run dev`.
# Di GitHub, nilai ini diatur lewat Settings > Secrets and variables > Actions > Variables.
# ---------------------------------------------------------------------------

# URL Web App Google Apps Script (berakhiran /exec) — lihat apps-script/README.md.
# Di GitHub: variabel repo APPS_SCRIPT_URL.
NEXT_PUBLIC_API_URL=

# Sub-path situs. Kosongkan untuk lokal / domain sendiri; GitHub Actions mengisinya otomatis
# (mis. /smartpusbek). Tidak perlu diatur manual di GitHub.
NEXT_PUBLIC_BASE_PATH=
